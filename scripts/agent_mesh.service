[Unit]
Description=Agent Mesh Service for AI Second Brain
After=network.target

[Service]
Type=simple
# Update the paths below to match your installation directory
ExecStart=/usr/bin/env python3 %h/AI-Second-Brain/.agent_mesh/scripts/agent_mesh_service.py
WorkingDirectory=%h/AI-Second-Brain
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/AI-Second-Brain/.agent_mesh/logs/agent_mesh.log
StandardError=append:%h/AI-Second-Brain/.agent_mesh/logs/agent_mesh.log
# Load your token and config from the environment file
EnvironmentFile=-%h/AI-Second-Brain/.env.local

[Install]
WantedBy=default.target