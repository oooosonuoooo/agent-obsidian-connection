# =============================================================
# Agent Obsidian Connection - Example Environment Configuration
# =============================================================
# COPY THIS FILE TO .env.local AND FILL IN YOUR OWN VALUES.
# DO NOT COMMIT YOUR REAL .env.local FILE TO GIT.
# =============================================================

# ------ Agent Mesh Token ------
# Generate a strong random token: python3 -c "import secrets; print(secrets.token_hex(32))"
export AGENT_MESH_TOKEN=your_agent_mesh_token_here

# ------ Agent Mesh Port ------
export AGENT_MESH_PORT=17860

# ------ Obsidian Vault Path (optional override) ------
# Defaults to ~/AI-Second-Brain/AI-Second-Brain-Vault
# export OBSIDIAN_VAULT_PATH=/path/to/your/vault

# ------ Friday Local LLM Bridge Settings ------
# export FRIDAY_LOCAL_BASE_URL=http://127.0.0.1:8765
# export FRIDAY_WEB_TOKEN=your_friday_web_token_here
# export FRIDAY_SECOND_BRAIN_BRIDGE_INTERVAL=60

# ------ Agent Mesh DB Path (optional override) ------
# Defaults to ~/AI-Second-Brain/.agent_mesh/agent_mesh.sqlite
# export AGENT_MESH_DB_PATH=/path/to/agent_mesh.sqlite

# ------ Durable Orchestration (safe defaults) ------
export AGENT_ACK_TIMEOUT=30
export AGENT_EXECUTION_TIMEOUT=1800
export AGENT_MAX_RETRIES=2
export AGENT_RETRY_BACKOFF=2
export AGENT_HEARTBEAT_TIMEOUT=120
export MAX_PARALLEL_AGENT_TASKS=8
export MAX_DELEGATION_DEPTH=3
export MAX_DELEGATION_CHILDREN=8
export MAX_DELEGATION_BATCHES_PER_TASK=3
export MAX_TASKS_PER_RUN=64
export AGENT_MESH_REAPER_INTERVAL=1

# ------ Autonomous lead/worker supervisor ------
# Enabled by default. Any MCP-connected agent can submit one objective as lead.
export AGENT_MESH_AUTONOMY_ENABLED=1
export AGENT_MESH_AUTONOMY_INTERVAL=1
export AGENT_MESH_AUTONOMY_MAX_WORKERS=4
export AGENT_MESH_AUTONOMY_MAX_ROUNDS=3
export AGENT_MESH_AUTONOMY_COMMAND_TIMEOUT=1800

# Optional caller identity. Existing clients can omit this and pass lead_agent
# to agent_mesh_start_autonomous_run; no per-agent bus configuration is needed.
# export AGENT_MESH_AGENT_NAME=MyAgent
# export AGENT_MESH_DEFAULT_LEAD=orchestrator
# export AGENT_MESH_WORKSPACE=/path/to/project

# Built-in Gemini CLI adapter permission mode (use the mode appropriate for
# your local trust boundary; yolo is the default for unattended execution).
# export AGENT_MESH_GEMINI_APPROVAL_MODE=yolo

# ------ LocalLLM Ollama worker ------
# The shared adapter becomes callable after this model is installed locally.
# export LOCAL_LLM_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
# export LOCAL_LLM_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat

# ------ AI Second Brain Root (optional override) ------
# Defaults to ~/AI-Second-Brain
# export AI_SECOND_BRAIN_ROOT=/path/to/AI-Second-Brain
